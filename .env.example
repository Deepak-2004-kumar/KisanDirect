# ============================================================
# KisanDirect - Environment Variables (copy to .env and edit)
# ============================================================

# --- General ---
ENV=development

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_USER=kisandirect
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=kisandirect
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://kisandirect:change_me_strong_password@localhost:5432/kisandirect

# --- JWT Auth ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite reads VITE_ prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000
